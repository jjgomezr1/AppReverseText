[Unit]
Description=App Inversor de Texto (Flask + gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/app
# gunicorn sirve el objeto WSGI "app" del modulo "app.py" -> app:app
# Escucha en el puerto 80 (HTTP estandar) en todas las interfaces, para que
# el Application Load Balancer pueda hacerle health check y enviarle trafico.
ExecStart=/home/ubuntu/app/venv/bin/gunicorn --bind 0.0.0.0:80 --workers 2 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
